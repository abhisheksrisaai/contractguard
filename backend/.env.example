# ContractGuard Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM Providers (multi-provider, auto-fallthrough) ──────────────
# PROVIDER_ORDER: comma-separated list; order determines fallthrough priority.
#   groq    = Groq GPT-OSS 120B (verified live 2026-09-13)
#   groq_8b = Groq GPT-OSS 20B (verified live 2026-09-13)
#   gemini  = Google Gemini 3.6 Flash (fallback; old SDK truncates new models)
#   ollama  = local dev only (optional)
PROVIDER_ORDER=groq,groq_8b,gemini

# Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
*****************************

# Ollama (local dev only — set OLLAMA_BASE_URL to enable)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# ── Qdrant Vector DB ────────────────────────────────────────────
QDRANT_MODE=local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_LOCAL_PATH=

# ── Embedding Model ─────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Application ─────────────────────────────────────────────────
APP_DEBUG=true
APP_PORT=8000
MAX_UPLOAD_SIZE_MB=10

# ── CORS ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
