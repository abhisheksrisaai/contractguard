# ContractGuard Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM Providers (Groq only) ──────────────────────────────────
# PROVIDER_ORDER: comma-separated list; order determines fallthrough priority.
# Qwen 3.8 27B is the only active model. The gpt-oss lanes are not enabled.
PROVIDER_ORDER=groq

# Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama (local dev only — set OLLAMA_BASE_URL to enable)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# ── LLM Reliability ─────────────────────────────────────────────
# Per-attempt timeout, total budget for one LLM call, retries per provider.
LLM_REQUEST_TIMEOUT=45
LLM_TOTAL_TIMEOUT=150
LLM_MAX_RETRIES=1
# Free-plan Groq models are capped at 8K tokens/minute per model.
LLM_TPM_LIMIT=8000
LLM_MAX_CONCURRENCY=3
# Skip a rate-limited provider briefly; open the circuit after N failures.
LLM_RATE_LIMIT_COOLDOWN=12
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN=30

# ── Qdrant Vector DB ────────────────────────────────────────────
QDRANT_MODE=local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_LOCAL_PATH=

# ── Embedding Model ─────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Application ─────────────────────────────────────────────────
APP_DEBUG=true
APP_PORT=8000
MAX_UPLOAD_SIZE_MB=10

# ── CORS ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
