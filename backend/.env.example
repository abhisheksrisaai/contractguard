# ContractGuard Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM Providers (multi-provider, auto-fallthrough) ──────────────
# PROVIDER_ORDER: comma-separated list; order determines fallthrough priority.
#   gemini  = Google Gemini 2.0 Flash (1,500 req/day free)
#   groq    = Groq LLaMA 3.3 70B (1,000 req/day free, 100K TPD)
#   groq_8b = Groq LLaMA 3.1 8B (14,400 req/day free, unlimited TPD)
#   ollama  = local dev only (optional)
PROVIDER_ORDER=gemini,groq,groq_8b

# Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local dev only — set OLLAMA_BASE_URL to enable)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# ── Qdrant Vector DB ────────────────────────────────────────────
QDRANT_MODE=local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_LOCAL_PATH=

# ── Embedding Model ─────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Application ─────────────────────────────────────────────────
APP_DEBUG=true
APP_PORT=8000
MAX_UPLOAD_SIZE_MB=10

# ── CORS ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
